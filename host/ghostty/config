# JetBrainsMono Nerd Font Mono ships JetBrains Mono plus 9,000+ icon
# glyphs (Devicons, Material Design, Font Awesome, Octicons, etc.) all
# at single-cell width. The "Mono" variant matters: without it, many
# PUA glyphs render double-wide and break panel borders in starship
# and lualine.
font-family = JetBrainsMono Nerd Font Mono
font-size = 14

# Don't pop a "process is still running" dialog when closing any window
# with a live foreground process. Power-user default.
confirm-close-surface = false

# Borderless, maximized on launch. `window-decoration = false` hides
# Ghostty's GTK header bar; `maximize = true` opens each new window
# filling the workspace (no titlebar, no gaps, but not the exclusive
# fullscreen mode that hides the system panel).
window-decoration = false
maximize = true

# GitHub Dark color scheme (terminalcolors.com/themes/github/dark).
# Shared with starship and tmux — see tmux.conf for the palette
# mapping.
background = #010409
foreground = #e6edf3
selection-background = #264f78
selection-foreground = #e6edf3
cursor-color = #e6edf3
cursor-text = #010409
palette = 0=#484f58
palette = 1=#ff7b72
palette = 2=#3fb950
palette = 3=#d29922
palette = 4=#58a6ff
palette = 5=#bc8cff
palette = 6=#39c5cf
palette = 7=#b1bac4
